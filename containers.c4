model {
  extend takodu {
    webApp = component 'Web Application' {
      description 'Web interface for managing Takodu\'s business operations.'
      technology '[Container: Next.js 16]'
      style {
        shape browser
      }
    }

    api = component 'API' {
      description 'Backend API handling petty cash, appointments, integrations, and salon analytics.'
      technology '[Container: Java 21]'
    }

    database = component 'Takodu Database' {
      description 'Distributed database for persistent transactional and operational data.'
      technology '[Container: Cassandra]'
      style {
        shape cylinder
      }
    }

    webApp -> api 'sends requests'
    api -> database 'reads and writes data'

    api -> decolecta 'validates documents and data'
    api -> googleOauth 'authenticates users'
    api -> resend 'sends emails'
    api -> stripe 'processes payments'
  }
}

views {
  view containers of takodu {
    title 'Takodu - Containers'
    include *
  }
}
