deployment {
  environment production 'Production' {
    server vercel 'Vercel' {
      webApp = instanceOf takodu.webApp
    }

    server contaboVps 'Contabo VPS' {
      api = instanceOf takodu.api
    }

    storage contaboStorage 'Contabo Storage' {
      database = instanceOf takodu.database
    }
  }
}

views {
  deployment view deployment {
    title 'Takodu - Deployment'
    include *
  }
}
