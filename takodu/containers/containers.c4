model {
  extend takodu {
    webApp = container 'Web Application' {
      description 'Web interface for managing Takodu\'s business operations.'
      technology 'Next.js 16'
      style {
        shape browser
      }
    }

    api = container 'API' {
      description 'Backend API handling business logic, appointments, and integrations.'
      technology 'Java 21 / Spring Boot'
    }

    database = container 'Takodu Database' {
      description 'Relational database for persistent transactional and operational data.'
      technology 'PostgreSQL'
      style {
        shape cylinder
      }
    }

    webApp -> api {
      title 'sends requests'
      technology 'HTTPS'
    }
    api -> database {
      title 'reads and writes data'
      technology 'SQL'
    }

    api -> decolecta {
      title 'validates documents and data'
      technology 'HTTPS (Circuit Breaker)'
    }
    api -> googleOauth {
      title 'authenticates users'
      technology 'HTTPS'
    }
    api -> resend {
      title 'sends emails'
      technology 'HTTPS (Asynchronous)'
    }
    api -> stripe {
      title 'processes payments'
      technology 'HTTPS (Circuit Breaker)'
    }
    api -> aiProvider {
      title 'sends prompts and processes natural language'
      technology 'HTTPS'
    }
  }
}

views {
  view containers of takodu {
    title 'Takodu - Containers'
    include *
  }
}
