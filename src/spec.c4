specification {

  // === C4 element kinds =====================================================
  // C4 actors (people) and software systems
  element actor {
    style {
      shape: person
    }
  }
  element system

  // C4 containers inside a software system
  element webapp {
    style {
      shape: browser
    }
  }
  element api {
    style {
      shape: rectangle
    }
  }
  element database {
    style {
      shape: cylinder
    }
  }
  element cache {
    style {
      shape: cylinder
    }
  }

  // C4 components inside a container
  element component {
    style {
      shape: rectangle
    }
  }

  // === Tags ================================================================
  // Free-form tags that classify elements (external systems, technology,
  // domain). Declared here so the parser resolves `#tag` references.

  tag external
  tag ai
  tag api
  tag email
  tag push
  tag payment
  tag identity

  tag nextjs
  tag spring
  tag postgresql
  tag redis
}