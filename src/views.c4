views {

  // === System Context ======================================================
  // Level 1: Takodu + actors + adjacent external systems.

  view systemContext of takodu {
    title 'Takodu Platform — System Context'
    description '
      Who uses the platform and which external systems
      it integrates with.
    '
    include *
    autoLayout LeftRight
  }

  // === Containers ==========================================================
  // Level 2: inside Takodu, expose Gremory, Haimiya, Database, Cache.

  view containers of takodu {
    title 'Takodu Platform — Containers'
    description '
      Deployable units inside Takodu: web app, REST API,
      PostgreSQL, Redis.
    '
    include *
    autoLayout LeftRight
  }

  // === Components: Haimiya =================================================
  // Level 3: 13 components inside the Haimiya REST API.

  view haimiyaComponents of takodu.haimiya {
    title 'Haimiya API — Components'
    description '
      Bounded contexts inside the Haimiya REST API.
      External integrations and the Cache / Database
      are shown when relevant.
    '
    include *
    autoLayout LeftRight
  }
}