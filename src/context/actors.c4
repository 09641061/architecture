model {

  // === Actors ===============================================================
  // C4 level 1: people who interact with the Takodu Platform.

  owner = actor 'MYPE Owner' {
    description '
      Owner or administrator of a MYPE business.
      Manages services, staff, and occupation reports.
    '
  }

  employer = actor 'MYPE Employee' {
    description '
      Frontline MYPE worker (receptionist, stylist, therapist).
      Checks the daily agenda and receives reschedule alerts.
    '
  }
}