model {

  // === Internal > Gorush PostgreSQL =========================================
  // Top-level: relational store that Gorush uses internally to persist
  // notification queue state, device subscriptions, and delivery logs.
  // Self-hosted on the kota NixOS server, but conceptually a separate
  // software system (not part of the Takodu domain boundary). Co-located
  // here because it shares the same self-hosted infrastructure footprint
  // as the other internal services and is not an external system. Separate
  // from the Haimiya PostgreSQL instance (see haimiya-db.c4).

  gorushDb = database 'Gorush PostgreSQL' {
    #postgresql
    description '
      Relational store owned by Gorush for push
      queue state, device subscriptions, and
      delivery logs. Separate from Haimiya
      PostgreSQL.
    '
    technology 'PostgreSQL 16'
    icon: https://icons.d2lang.com/dev%2Fpostgresql.svg
  }
}
