model {

  // === Relationships ========================================================
  // Cross-layer relationships. Direction: `from -> to 'description' [tech]`.

  // ---- People -> container -------------------------------------------------
  owner -> takodu.gremory 'Manages subscription, services, staff, and occupation reports'
  employer -> takodu.gremory 'Checks the daily agenda and receives reschedule alerts'

  // ---- Frontend -> backend -------------------------------------------------
  takodu.gremory -> takodu.haimiya 'Calls business endpoints over HTTPS' {
    technology 'HTTPS/REST'
  }

  // ---- Component -> Cache (Redis) ------------------------------------------
  // Redis users: iam (sessions/tokens), assistant (@Cacheable on ACL facades),
  // workforce (invitation tokens).
  takodu.haimiya.iam -> takodu.cache 'Stores sessions, tokens, and rate-limit counters' {
    technology 'RESP/Redis'
  }
  takodu.haimiya.assistant -> takodu.cache 'Caches availability, appointments, and services' {
    technology 'RESP/Redis'
  }
  takodu.haimiya.workforce -> takodu.cache 'Indexes invitation tokens' {
    technology 'RESP/Redis'
  }

  // ---- Component -> Database (Haimiya PostgreSQL) --------------------------
  // 12 of 13 contexts use the Haimiya PostgreSQL; `media` has no own schema
  // (delegates everything to Openinary). Gorush has its own PostgreSQL
  // (`takodu.gorushDb`) declared as a separate container below.
  takodu.haimiya.iam -> takodu.haimiyaDb 'Reads and writes users, roles, and sessions' {
    technology 'JDBC/PostgreSQL'
  }
  takodu.haimiya.assistant -> takodu.haimiyaDb 'Persists conversation history and resolved intents' {
    technology 'JDBC/PostgreSQL'
  }
  takodu.haimiya.scheduling -> takodu.haimiyaDb 'Reads and writes appointments and availability' {
    technology 'JDBC/PostgreSQL'
  }
  takodu.haimiya.workforce -> takodu.haimiyaDb 'Reads and writes staff, roles, and permissions' {
    technology 'JDBC/PostgreSQL'
  }
  takodu.haimiya.business -> takodu.haimiyaDb 'Reads and writes organizations and establishments' {
    technology 'JDBC/PostgreSQL'
  }
  takodu.haimiya.catalog -> takodu.haimiyaDb 'Reads and writes services and pricing' {
    technology 'JDBC/PostgreSQL'
  }
  takodu.haimiya.crm -> takodu.haimiyaDb 'Reads and writes customers' {
    technology 'JDBC/PostgreSQL'
  }
  takodu.haimiya.profiles -> takodu.haimiyaDb 'Reads and writes owner and employee profiles' {
    technology 'JDBC/PostgreSQL'
  }
  takodu.haimiya.billing -> takodu.haimiyaDb 'Reads and writes subscriptions and invoices' {
    technology 'JDBC/PostgreSQL'
  }
  takodu.haimiya.notifications -> takodu.haimiyaDb 'Reads and writes notification templates and logs' {
    technology 'JDBC/PostgreSQL'
  }
  takodu.haimiya.audit -> takodu.haimiyaDb 'Appends audit events' {
    technology 'JDBC/PostgreSQL'
  }
  takodu.haimiya.analytics -> takodu.haimiyaDb 'Reads operational data via dedicated read repositories' {
    technology 'JDBC/PostgreSQL'
  }

  // ---- Cross-context ACL (Anti-Corruption Layer) ---------------------------
  // Derived from each context's
  // `import com.takodu.<other>.interfaces.acl` / `application.acl`.
  takodu.haimiya.iam -> takodu.haimiya.notifications 'Sends auth-related notifications via ACL' {
    technology 'ACL'
  }
  takodu.haimiya.assistant -> takodu.haimiya.business 'Resolves tenant and establishment data via ACL' {
    technology 'ACL'
  }
  takodu.haimiya.assistant -> takodu.haimiya.catalog 'Resolves service catalog data via ACL' {
    technology 'ACL'
  }
  takodu.haimiya.assistant -> takodu.haimiya.crm 'Resolves customer identity and records via ACL' {
    technology 'ACL'
  }
  takodu.haimiya.assistant -> takodu.haimiya.scheduling 'Resolves availability and appointment data via ACL' {
    technology 'ACL'
  }
  takodu.haimiya.assistant -> takodu.haimiya.workforce 'Resolves staff and permission data via ACL' {
    technology 'ACL'
  }
  takodu.haimiya.analytics -> takodu.haimiya.billing 'Gates plan access via ACL' {
    technology 'ACL'
  }
  takodu.haimiya.audit -> takodu.haimiya.business 'Resolves tenant context for audit records via ACL' {
    technology 'ACL'
  }
  takodu.haimiya.audit -> takodu.haimiya.workforce 'Resolves staff context for audit records via ACL' {
    technology 'ACL'
  }
  takodu.haimiya.billing -> takodu.haimiya.business 'Resolves tenant and establishment data via ACL' {
    technology 'ACL'
  }
  takodu.haimiya.billing -> takodu.haimiya.iam 'Resolves user identity and roles via ACL' {
    technology 'ACL'
  }
  takodu.haimiya.business -> takodu.haimiya.billing 'Resolves plan limits and subscription status via ACL' {
    technology 'ACL'
  }
  takodu.haimiya.business -> takodu.haimiya.iam 'Resolves user identity and roles via ACL' {
    technology 'ACL'
  }
  takodu.haimiya.business -> takodu.haimiya.media 'Resolves media asset references via ACL' {
    technology 'ACL'
  }
  takodu.haimiya.business -> takodu.haimiya.workforce 'Resolves staff and permission data via ACL' {
    technology 'ACL'
  }
  takodu.haimiya.catalog -> takodu.haimiya.workforce 'Resolves staff permissions via ACL' {
    technology 'ACL'
  }
  takodu.haimiya.crm -> takodu.haimiya.business 'Resolves tenant and establishment data via ACL' {
    technology 'ACL'
  }
  takodu.haimiya.crm -> takodu.haimiya.workforce 'Resolves staff data via ACL' {
    technology 'ACL'
  }
  takodu.haimiya.notifications -> takodu.haimiya.iam 'Resolves user contact info via ACL' {
    technology 'ACL'
  }
  takodu.haimiya.notifications -> takodu.haimiya.workforce 'Resolves staff data via ACL' {
    technology 'ACL'
  }
  takodu.haimiya.profiles -> takodu.haimiya.media 'Resolves media asset references via ACL' {
    technology 'ACL'
  }
  takodu.haimiya.scheduling -> takodu.haimiya.workforce 'Resolves staff availability via ACL' {
    technology 'ACL'
  }
  takodu.haimiya.workforce -> takodu.haimiya.billing 'Resolves plan limits via ACL' {
    technology 'ACL'
  }
  takodu.haimiya.workforce -> takodu.haimiya.business 'Resolves tenant data via ACL' {
    technology 'ACL'
  }
  takodu.haimiya.workforce -> takodu.haimiya.iam 'Resolves user identity and roles via ACL' {
    technology 'ACL'
  }
  takodu.haimiya.workforce -> takodu.haimiya.notifications 'Resolves notification preferences via ACL' {
    technology 'ACL'
  }
  takodu.haimiya.workforce -> takodu.haimiya.profiles 'Resolves profile data via ACL' {
    technology 'ACL'
  }

  // ---- Component -> External system ---------------------------------------
  // Verified against actual outbound HTTP clients / SDKs.
  takodu.haimiya.iam -> google 'Exchanges authorization codes for Google OAuth tokens' {
    technology 'HTTPS/OAuth 2'
  }
  takodu.haimiya.assistant -> deepseek 'Sends chat completion requests to the LLM' {
    technology 'HTTPS/REST'
  }
  takodu.haimiya.billing -> stripe 'Creates checkout sessions and processes subscription charges' {
    technology 'HTTPS/REST'
  }
  takodu.haimiya.crm -> decoleta 'Looks up customer identity by document number' {
    technology 'HTTPS/REST'
  }
  takodu.haimiya.media -> takodu.openinary 'Uploads and transforms media assets' {
    technology 'HTTPS/REST'
  }
  takodu.haimiya.notifications -> ses 'Sends transactional email through Amazon SESv2' {
    technology 'HTTPS/REST'
  }
  takodu.haimiya.notifications -> takodu.gorush 'Dispatches push notifications to employee devices' {
    technology 'HTTPS/REST'
  }

  // ---- Container -> External system ---------------------------------------
  // Aggregated view of every external integration owned by the Haimiya
  // REST API. Mirrors the component-level relationships above so the
  // containers view (C4 level 2) can show the full external surface of
  // Haimiya without leaking component internals.
  takodu.haimiya -> google 'Authenticates MYPE users and employees through Google OAuth 2' {
    technology 'HTTPS/OAuth 2'
  }
  takodu.haimiya -> deepseek 'Calls the LLM that powers the conversational booking agent' {
    technology 'HTTPS/REST'
  }
  takodu.haimiya -> stripe 'Manages MYPE subscription billing and one-off charges' {
    technology 'HTTPS/REST'
  }
  takodu.haimiya -> decoleta 'Enriches customer identity records from external registries' {
    technology 'HTTPS/REST'
  }
  takodu.haimiya -> ses 'Sends transactional email through Amazon SES' {
    technology 'HTTPS/REST'
  }
  takodu.gremory -> takodu.gorush 'Registers the service worker and subscribes employee browsers to push notifications' {
    technology 'HTTPS/REST'
  }
  takodu.gremory -> stripe 'Tokenizes payment methods in the browser through Stripe.js' {
    technology 'HTTPS/REST'
  }
  takodu.gremory -> google 'Signs MYPE users in via Google Identity Services in the browser' {
    technology 'HTTPS/OAuth 2'
  }

  // ---- Container -> Internal container -------------------------------------
  // Container-to-container relationships inside the Takodu boundary that
  // are not derived from any component-level edge. Openinary stores
  // originals and processed derivatives in the S3-compatible Garage bucket,
  // and Gorush uses its own PostgreSQL instance to persist push queue
  // state, device subscriptions, and delivery logs.
  takodu.openinary -> takodu.garage 'Persists media assets and derivatives in the S3-compatible bucket' {
    technology 'HTTPS/S3'
  }
  takodu.gorush -> takodu.gorushDb 'Persists push queue state, device subscriptions, and delivery logs' {
    technology 'JDBC/PostgreSQL'
  }

  // ---- Deployment manager -> Managed container -----------------------------
  // Dokploy is the self-hosted PaaS that owns the deployment lifecycle of
  // every container running on the NixOS servers. Edges below point to
  // the primary container of each managed stack; the rest of the stack
  // (databases, cache, object store) is co-deployed with its owner and
  // therefore implicitly managed too.
  takodu.dokploy -> takodu.haimiya 'Orchestrates the Haimiya stack on azusa nixos server' {
    technology 'Docker'
  }
  takodu.dokploy -> takodu.gorush 'Orchestrates the Gorush stack on kota nixos server' {
    technology 'Docker'
  }
  takodu.dokploy -> takodu.openinary 'Orchestrates the Openinary media service on kota nixos server' {
    technology 'Docker'
  }
}