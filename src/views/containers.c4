views {

  // === Containers ==========================================================
  // C4 level 2: Gremory, Haimiya, PostgreSQL, and Redis are grouped inside
  // the Takodu boundary. Actors remain outside because they use Gremory.

  view containers of takodu {
    title 'Takodu Platform — Containers'
    description '
      Gremory, Haimiya, PostgreSQL, and Redis inside the Takodu Platform boundary.
      Actors remain outside the platform.
    '
    group 'Takodu Platform' {
      include takodu.gremory, takodu.haimiya, takodu.db, takodu.cache
    }
    include owner, employer
    autoLayout LeftRight
  }
}