views {

  // === Containers ==========================================================
  // C4 level 2. Two groups sit at the top level, side by side:
  //   * "Takodu Platform" — the Takodu domain boundary, containing
  //                          Gremory, Traefik, Haimiya, Haimiya
  //                          PostgreSQL, and Redis. Traefik is visually
  //                          nested inside a `dokploy cloud` sub-boundary
  //                          to mirror the deploy view and signal that it
  //                          is the edge / control plane of the self-hosted
  //                          PaaS layer.
  //   * "internal"        — co-located self-hosted infrastructure
  //                          (Garage, Openinary, Gorush, Gorush
  //                          PostgreSQL) that runs alongside Takodu on
  //                          the NixOS servers but is conceptually
  //                          outside the Takodu domain. They live in
  //                          src/internal/ for that reason and are
  //                          declared as top-level elements (not under
  //                          `extend takodu`), so they appear here as
  //                          siblings of the Takodu Platform group
  //                          instead of being nested inside it.
  // Every external system that Haimiya integrates with is shown attached
  // to the Haimiya container. Gremory also reaches Google OAuth 2 and
  // Stripe directly from the browser. Openinary persists media assets in
  // Garage (S3-compatible object storage). Actors remain outside because
  // they use Gremory.

  view containers {
    title 'Takodu Platform — Containers'
    description '
      Two top-level groups: "Takodu Platform" contains the Takodu domain
      containers (Gremory, Traefik, Haimiya, Haimiya PostgreSQL, and
      Redis); "internal" contains the co-located self-hosted
      infrastructure (Garage, Openinary, Gorush, Gorush PostgreSQL) that
      runs alongside Takodu but is outside the Takodu domain. Traefik
      is drawn inside its own `dokploy cloud` sub-group to mirror the
      deploy view, signalling that it is the edge reverse proxy of the
      self-hosted infrastructure. Haimiya is shown attached to every
      external system it integrates with (Google OAuth 2, DeepSeek,
      Stripe, Decoleta, Amazon SES, WhatsApp Business). The frontend
      never reaches Haimiya directly: Gremory sends every business API
      call to Traefik, which terminates TLS and routes the request to
      Haimiya inside the platform. Gremory also reaches Google OAuth 2
      and Stripe directly from the browser. Openinary persists media
      assets in Garage (S3-compatible object storage). All three actors
      (owner, employer, consumer) remain outside the platform: owner and
      employer interact with it through Gremory; the end consumer
      (final client) does not hold a Takodu account and is reached only
      through WhatsApp, transactional email, and push notifications.
    '
    include owner, employer, consumer
    group 'External Services' {
      include deepseek, decoleta, ses, google, googleCalendar, stripe, whatsapp
    }

    group 'Takodu Platform' {
      // Edge / control plane of the self-hosted PaaS layer. Mirrors the
      // same sub-group used in the deploy view (`dokploy cloud` inside
      // `dokploy takodu cloud`). Dokploy is intentionally not included
      // here because the containers view models running services, not
      // the deployment manager that orchestrates them.
      group 'dokploy cloud' {
        color: indigo
        include takodu.traefik
      }
      include takodu.gremory, takodu.haimiya, takodu.haimiyaDb, takodu.cache
    }

    group 'internal' {
      include openinary, gorush
    }

    autoLayout LeftRight
  }
}
