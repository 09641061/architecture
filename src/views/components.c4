views {

  // === Components: Haimiya =================================================
  // C4 level 3: 13 components inside the Haimiya REST API together with the
  // data stores and external systems those components depend on.
  //
  // Includes:
  //   - All 13 bounded contexts inside Haimiya (`takodu.haimiya.*`)
  //   - Haimiya PostgreSQL (`takodu.haimiyaDb`) — read/written by 12 components
  //   - Redis              (`takodu.cache`)    — used by iam, assistant, workforce
  //   - Internal co-located infrastructure reached by Haimiya components:
  //       openinary     (media processing)
  //       garage        (S3-compatible object store used by Openinary)
  //       gorush        (push notification gateway used by notifications)
  //   - Gorush PostgreSQL (`gorushDb`) — owned by Gorush, not by Haimiya,
  //     but shown for completeness because Gorush sits in the dependency
  //     chain. These four are top-level elements (not children of the
  //     `takodu` system), so they are referenced by their unqualified
  //     names.
  //   - External systems reached by Haimiya components:
  //       deepseek, google, googleCalendar, stripe, decoleta, ses, whatsapp
  //
  // The view does not include people / actors (those belong to context and containers).

  view haimiyaComponents of takodu.haimiya {
    title 'Haimiya API — Components'
    description '
      The 13 bounded contexts inside Haimiya, plus the
      Haimiya PostgreSQL / Redis stores they read and
      write, the in-platform Openinary media service
      backed by the Garage S3-compatible bucket, the
      in-platform Gorush push notification gateway
      (with its own PostgreSQL), and the external
      systems they integrate with (LLM, OAuth, calendar
      sync, payments, identity lookup, email,
      WhatsApp).
    '
    group 'Haimiya API' {
      include takodu.haimiya.*
    }
    style takodu.haimiya.* {
      color primary
    }
    group 'Internal Containers' {
      include takodu.haimiyaDb, takodu.cache, openinary, gorush
    }
    group 'External Services' {
      include deepseek, google, googleCalendar, stripe, decoleta, ses, whatsapp
    }
    autoLayout LeftRight 0 0
  }
}