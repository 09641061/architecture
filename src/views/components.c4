views {

  // === Components: Haimiya =================================================
  // C4 level 3: 13 components inside the Haimiya REST API together with the
  // data stores and external systems those components depend on.

  view haimiyaComponents of takodu.haimiya {
    title 'Haimiya API — Components'
    description '
      The bounded contexts inside Haimiya, plus the
      Haimiya PostgreSQL / Redis stores they read and
      write, the in-platform Openinary media service
      backed by the Garage S3-compatible bucket, the
      in-platform Gorush push notification gateway
      (with its own PostgreSQL), and the external
      systems they integrate with.
    '
    group 'Haimiya API' {
      include takodu.haimiya.*
    }
    style takodu.haimiya.* {
      color primary
    }
    group 'dokploy cloud' {
      color: indigo
      include takodu.traefik
    }
    group 'Internal Containers' {
      include takodu.haimiyaDb, takodu.cache, openinary, gorush
    }
    group 'External Services' {
      include deepseek, google, googleCalendar, stripe, ses, whatsapp
    }
    autoLayout LeftRight 0 0
  }

  // === 1. Scheduling Bounded Context =======================================
  view schedulingComponents of takodu.haimiya.scheduling {
    title 'Scheduling Bounded Context — Component Architecture (DDD)'
    description 'Componentes tácticos de Scheduling: Interface, Application (CQRS), Domain e Infrastructure.'
    
    group 'Interface Layer' {
      include takodu.haimiya.scheduling.appointmentController,
              takodu.haimiya.scheduling.schedulingContextFacade,
              takodu.haimiya.scheduling.schedulingAssemblers,
              takodu.haimiya.scheduling.schedulingDtos
    }
    group 'Application Layer' {
      include takodu.haimiya.scheduling.appointmentCommandService,
              takodu.haimiya.scheduling.appointmentQueryService,
              takodu.haimiya.scheduling.schedulingContextFacadeImpl
    }
    group 'Domain Layer' {
      include takodu.haimiya.scheduling.appointmentAggregates,
              takodu.haimiya.scheduling.schedulingCommands,
              takodu.haimiya.scheduling.schedulingQueries,
              takodu.haimiya.scheduling.schedulingValueObjects,
              takodu.haimiya.scheduling.schedulingDomainEvents
    }
    group 'Infrastructure Layer' {
      include takodu.haimiya.scheduling.scheduleRepository,
              takodu.haimiya.scheduling.redisRedlockAdapter,
              takodu.haimiya.scheduling.googleCalendarAdapter,
              takodu.haimiya.scheduling.schedulingWorkforceAclService,
              takodu.haimiya.scheduling.schedulingCatalogAclService
    }
    include takodu.haimiyaDb, takodu.cache, googleCalendar
    autoLayout TopBottom 0 0
  }

  // === 2. Catalog Bounded Context ==========================================
  view catalogComponents of takodu.haimiya.catalog {
    title 'Catalog Bounded Context — Component Architecture (DDD)'
    description 'Componentes tácticos de Catalog: Interface, Application (CQRS), Domain e Infrastructure.'
    
    group 'Interface Layer' {
      include takodu.haimiya.catalog.catalogController,
              takodu.haimiya.catalog.catalogContextFacade,
              takodu.haimiya.catalog.catalogAssemblers,
              takodu.haimiya.catalog.catalogDtos
    }
    group 'Application Layer' {
      include takodu.haimiya.catalog.catalogCommandService,
              takodu.haimiya.catalog.catalogQueryService,
              takodu.haimiya.catalog.catalogContextFacadeImpl
    }
    group 'Domain Layer' {
      include takodu.haimiya.catalog.catalogAggregates,
              takodu.haimiya.catalog.catalogCommands,
              takodu.haimiya.catalog.catalogQueries,
              takodu.haimiya.catalog.catalogValueObjects,
              takodu.haimiya.catalog.catalogDomainEvents
    }
    group 'Infrastructure Layer' {
      include takodu.haimiya.catalog.catalogRepository,
              takodu.haimiya.catalog.catalogWorkforceAclService
    }
    include takodu.haimiyaDb
    autoLayout TopBottom 0 0
  }

