model {

  // === External: Gorush =====================================================
  // Push notification gateway for real-time schedule alerts to employee devices.

  gorush = system 'Gorush' {
    #external, #push
    description '
      Push notification gateway for real-time
      schedule alerts to employee devices.
    '
    technology 'Gorush'
    style {
      color: amber
      border: dashed
      icon ../../icons/gorush.svg
    }
  }
}