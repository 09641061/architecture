model {

  // === Containers > takodu > PostgreSQL =====================================
  // C4 level 2: primary relational store.

  extend takodu {
    db = database 'PostgreSQL' {
      #postgresql
      description '
        Relational store for users, businesses, services, staff,
        appointments, and bookings.
      '
      technology 'PostgreSQL 16'
      icon: https://icons.d2lang.com/dev%2Fpostgresql.svg
    }
  }
}